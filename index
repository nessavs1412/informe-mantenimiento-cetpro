    <!-- ==========================================
         INVENTARIO DE LOS COMPONENTES ANALIZADOS
    =========================================== -->
    <section class="section section--alt" id="inventario" aria-labelledby="titulo-inventario">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-number">Anexo Técnico</span>
          <h2 id="titulo-inventario" class="section-title">INVENTARIO DE LOS COMPONENTES ANALIZADOS</h2>
          <p class="section-subtitle">Registra las especificaciones técnicas del equipo y periféricos del aula. Los datos se guardan automáticamente en este navegador.</p>
        </div>

        <form id="inventory-form" novalidate>
          <div class="inventory-grid">
            <!-- 1. PLACA MADRE -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">1. PLACA MADRE</legend>
              <div class="form-group">
                <label for="inv-mb-tipo">Tipo de placa madre</label>
                <input type="text" id="inv-mb-tipo" name="mb_tipo" class="form-control" placeholder="Ej. ATX / Micro-ATX">
              </div>
              <div class="form-group">
                <label for="inv-mb-modelo">Modelo de la placa madre</label>
                <input type="text" id="inv-mb-modelo" name="mb_modelo" class="form-control" placeholder="Ej. ASUS PRIME H510M-E">
              </div>
            </fieldset>

            <!-- 2. MICROPROCESADOR -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">2. MICROPROCESADOR</legend>
              <div class="form-group">
                <label for="inv-cpu-tipo">Tipo del procesador</label>
                <input type="text" id="inv-cpu-tipo" name="cpu_tipo" class="form-control" placeholder="Ej. Intel Core i5 / AMD Ryzen 5">
              </div>
              <div class="form-group">
                <label for="inv-cpu-gen">Generación</label>
                <input type="text" id="inv-cpu-gen" name="cpu_generacion" class="form-control" placeholder="Ej. 10ma Generación">
              </div>
              <div class="form-group">
                <label for="inv-cpu-socket">Socket</label>
                <input type="text" id="inv-cpu-socket" name="cpu_socket" class="form-control" placeholder="Ej. LGA 1200 / AM4">
              </div>
              <div class="form-group">
                <label for="inv-cpu-speed">Velocidad o Core speed</label>
                <input type="text" id="inv-cpu-speed" name="cpu_velocidad" class="form-control" placeholder="Ej. 2.90 GHz">
              </div>
            </fieldset>

            <!-- 3. MEMORIA -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">3. MEMORIA</legend>
              <div class="form-group">
                <label for="inv-ram-cap">Capacidad</label>
                <input type="text" id="inv-ram-cap" name="ram_capacidad" class="form-control" placeholder="Ej. 8 GB / 16 GB">
              </div>
              <div class="form-group">
                <label for="inv-ram-tipo">Tipo de memoria que usa</label>
                <input type="text" id="inv-ram-tipo" name="ram_tipo" class="form-control" placeholder="Ej. DDR4 2666 MHz">
              </div>
              <div class="form-group">
                <label for="inv-ram-slots">Slot o ranuras que usa</label>
                <input type="text" id="inv-ram-slots" name="ram_slots" class="form-control" placeholder="Ej. 2 de 2 ranuras DIMM">
              </div>
            </fieldset>

            <!-- 4. TARJETA DE VIDEO -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">4. TARJETA DE VIDEO</legend>
              <div class="form-group">
                <label for="inv-gpu-nombre">Nombre de la tarjeta de video</label>
                <input type="text" id="inv-gpu-nombre" name="gpu_nombre" class="form-control" placeholder="Ej. Intel UHD Graphics 630">
              </div>
              <div class="form-group">
                <label for="inv-gpu-mem">Cuánta memoria utiliza</label>
                <input type="text" id="inv-gpu-mem" name="gpu_memoria" class="form-control" placeholder="Ej. 2 GB / Integrada">
              </div>
            </fieldset>

            <!-- 5. MONITOR -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">5. MONITOR</legend>
              <div class="form-group">
                <label for="inv-monitor-tipo">Tipo de monitor</label>
                <input type="text" id="inv-monitor-tipo" name="monitor_tipo" class="form-control" placeholder="Ej. LED 21.5 pulgadas Full HD">
              </div>
            </fieldset>

            <!-- 6. TECLADO -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">6. TECLADO</legend>
              <div class="form-group">
                <label for="inv-teclado-marca">Marca del teclado</label>
                <input type="text" id="inv-teclado-marca" name="teclado_marca" class="form-control" placeholder="Ej. Logitech / Genius / HP">
              </div>
            </fieldset>

            <!-- 7. MOUSE -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">7. MOUSE</legend>
              <div class="form-group">
                <label for="inv-mouse-marca">Marca del mouse</label>
                <input type="text" id="inv-mouse-marca" name="mouse_marca" class="form-control" placeholder="Ej. Logitech / HP">
              </div>
            </fieldset>

            <!-- 8. SWITCH -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">8. SWITCH</legend>
              <div class="form-group">
                <label for="inv-switch-marca">Marca</label>
                <input type="text" id="inv-switch-marca" name="switch_marca" class="form-control" placeholder="Ej. TP-Link / Cisco">
              </div>
              <div class="form-group">
                <label for="inv-switch-puertos">Puertos</label>
                <input type="number" id="inv-switch-puertos" name="switch_puertos" class="form-control" min="1" max="128" step="1" placeholder="Ej. 24">
                <small class="field-error" id="err-switch-puertos" aria-live="polite"></small>
              </div>
            </fieldset>

            <!-- 9. PROYECTOR -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">9. PROYECTOR</legend>
              <div class="form-group">
                <label for="inv-proyector-marca">Marca</label>
                <input type="text" id="inv-proyector-marca" name="proyector_marca" class="form-control" placeholder="Ej. Epson / BenQ">
              </div>
            </fieldset>

            <!-- 10. ECRAN -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">10. ECRAN (pantalla de proyección)</legend>
              <div class="form-group">
                <span class="field-label" id="label-ecran">¿Funciona?</span>
                <div class="radio-group" role="radiogroup" aria-labelledby="label-ecran">
                  <label class="radio-option">
                    <input type="radio" name="ecran_funciona" value="Sí">
                    <span>Sí</span>
                  </label>
                  <label class="radio-option">
                    <input type="radio" name="ecran_funciona" value="No">
                    <span>No</span>
                  </label>
                </div>
              </div>
            </fieldset>

            <!-- 11. INTERNET -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">11. INTERNET</legend>
              <div class="form-group">
                <label for="inv-net-ipv4">IPv4</label>
                <input type="text" id="inv-net-ipv4" name="internet_ipv4" class="form-control ip-field" placeholder="Ej. 192.168.137.10" inputmode="decimal">
                <small class="field-error" id="err-net-ipv4" aria-live="polite"></small>
              </div>
              <div class="form-group">
                <label for="inv-net-mask">Máscara de subred</label>
                <input type="text" id="inv-net-mask" name="internet_mascara" class="form-control ip-field" placeholder="Ej. 255.255.255.0" inputmode="decimal">
                <small class="field-error" id="err-net-mask" aria-live="polite"></small>
              </div>
              <div class="form-group">
                <label for="inv-net-gateway">Puerta de enlace</label>
                <input type="text" id="inv-net-gateway" name="internet_gateway" class="form-control ip-field" value="192.168.137.1" placeholder="192.168.137.1" inputmode="decimal">
                <small class="field-error" id="err-net-gateway" aria-live="polite"></small>
              </div>
            </fieldset>

            <!-- 12. TELEVISOR -->
            <fieldset class="card inventory-card fade-in">
              <legend class="inventory-card__legend">12. TELEVISOR</legend>
              <div class="form-group">
                <label for="inv-tv-marca">Marca</label>
                <input type="text" id="inv-tv-marca" name="tv_marca" class="form-control" placeholder="Ej. Samsung / LG">
              </div>
              <div class="form-group">
                <label for="inv-tv-pulgadas">Pulgadas</label>
                <input type="number" id="inv-tv-pulgadas" name="tv_pulgadas" class="form-control" min="10" max="120" step="1" placeholder="Ej. 55">
                <small class="field-error" id="err-tv-pulgadas" aria-live="polite"></small>
              </div>
            </fieldset>
          </div>

          <!-- Acciones del formulario de inventario -->
          <div class="inventory-actions no-print fade-in">
            <button type="submit" id="btn-save-inventory" class="btn btn--primary">💾 Guardar</button>
            <button type="button" id="btn-export-inventory" class="btn btn--secondary">⬇️ Exportar inventario (.json)</button>
            <button type="button" id="btn-clear-inventory" class="btn btn--danger-outline">🗑️ Borrar todo</button>
          </div>
        </form>
      </div>
    </section>

    <!-- ==========================================
         SECCIÓN 9. FIRMAS
